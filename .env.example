# Bagley reads this file from the directory you start it in (copy it to .env).
# Every line is optional. Model settings set here are locked in the UI.

# --- Model server -----------------------------------------------------------
# auto | ollama | openai (any OpenAI-compatible API) | anthropic (Claude)
# BAGLEY_PROVIDER=auto
# Ollama: http://localhost:11434   LM Studio: http://localhost:1234/v1
# llama.cpp: http://localhost:8080/v1   vLLM: http://localhost:8000/v1
# Claude: https://api.anthropic.com (with BAGLEY_PROVIDER=anthropic, BAGLEY_MODEL=claude-opus-5-5)
# BAGLEY_BASE_URL=http://localhost:11434
# Only needed for hosted APIs. Empty: the provider's own variable below.
# BAGLEY_API_KEY=

# --- Hosted API keys --------------------------------------------------------
# Used by this machine and by cloud machines (Settings > Model & machines > Hosted APIs) whose
# key isn't saved in Settings. Add one with: bagley machines add Claude --preset claude
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# Leave empty to use the first installed model that supports tools.
# BAGLEY_MODEL=qwen3:4b
# BAGLEY_TEMPERATURE=0.6
# Context window sent to Ollama (num_ctx). Bagley also trims history to fit it.
# BAGLEY_CONTEXT_TOKENS=8192
# Tool rounds per reply.
# BAGLEY_MAX_STEPS=8
# auto | native | prompt (text-based, works with any model) | off
# BAGLEY_TOOL_MODE=auto
# Let reasoning models (qwen3, deepseek-r1, gpt-oss) think before answering.
# BAGLEY_THINK=false
# bagley | professional | concise
# BAGLEY_PERSONA=bagley

# --- Server -----------------------------------------------------------------
# BAGLEY_HOST=127.0.0.1
# BAGLEY_PORT=8765
# Required when listening beyond localhost; generated automatically if unset.
# BAGLEY_TOKEN=
# Extra host names allowed in the Host header (comma separated).
# BAGLEY_ALLOWED_HOSTS=

# --- Data and tools ---------------------------------------------------------
# BAGLEY_DATA_DIR=~/.bagley
# Folder the file tools can read and write. Defaults to <data dir>/workspace.
# BAGLEY_WORKSPACE=~/Documents/bagley
# Python files with extra tools. Defaults to <data dir>/plugins.
# BAGLEY_PLUGINS_DIR=
# MCP server list. Defaults to <data dir>/mcp.json.
# BAGLEY_MCP_CONFIG=
# Let Bagley run shell commands in the workspace (each one asks first).
# BAGLEY_ENABLE_SHELL=false
# Python used by the run_python tool (enabled with the shell). Defaults to Bagley's own.
# BAGLEY_PYTHON=~/venvs/data/bin/python
# Allow web tools to reach localhost and private network addresses.
# BAGLEY_ALLOW_PRIVATE_URLS=false
# Use your own SearXNG instance for web search instead of DuckDuckGo.
# BAGLEY_SEARXNG_URL=http://localhost:8888

# --- Phone, desktop and the rest ---------------------------------------------
# Address that notification clicks open, e.g. https://laptop.tailnet-name.ts.net:8765
# BAGLEY_PUBLIC_URL=
# Tailscale logins allowed to use Bagley over the tailnet (comma separated).
# BAGLEY_TAILSCALE_USERS=you@github
# Author emails counted in "Your life" (default: each repository's git config; * for everyone).
# BAGLEY_GIT_EMAILS=
# Force the watchdog tools on (1) or off (0). Default: on Linux.
# BAGLEY_WATCHDOG=
# For the clients (overlay, bagley see, the zsh plugin, bagley status): the server to talk to.
# BAGLEY_URL=http://127.0.0.1:8765
